      "teacherAnnotations": [
        {
          "id": "annotation-01",
          "segmentId": "segment-01",
          "note": "Le dispositif est posé comme un tour de présentation plurilingue : chacun peut mobiliser sa langue et son répertoire.",
          "pedagogicalQuestion": "Comment le cadre autorise-t-il chaque personne à utiliser son propre répertoire linguistique ?"
        },
        {
          "id": "annotation-02",
          "segmentId": "segment-02",
          "note": "Présentation de soi et ancrage institutionnel. Moment utile pour observer la mise en place d’un contexte partagé.",
          "pedagogicalQuestion": "Quels éléments de présentation créent un contexte partagé pour le groupe ?",
          "overlay": null
        },
        {
          "id": "annotation-03",
          "segmentId": "segment-03",
          "note": "Le répertoire linguistique est explicité : langues maîtrisées, langues en cours d’apprentissage, expérience de mobilité.",
          "pedagogicalQuestion": "Que nous apprend ce segment sur la diversité des compétences dans un même répertoire ?",
          "overlay": null
        },
        {
          "id": "annotation-04",
          "segmentId": "segment-04",
          "note": "Premier contrôle collectif de compréhension. La compréhension devient un objet partagé, pas seulement individuel.",
          "pedagogicalQuestion": "Qu’est-ce que le groupe vérifie collectivement à ce moment ?"
        },
        {
          "id": "annotation-05",
          "segmentId": "segment-05",
          "note": "Le changement de langue est annoncé et ritualisé. C’est un marqueur fort pour une vidéo augmentée IC.",
          "pedagogicalQuestion": "Comment le changement de langue est-il préparé pour ne pas devenir une rupture ?"
        },
        {
          "id": "annotation-06",
          "segmentId": "segment-06",
          "note": "Segment hybride : italien, espagnol et français se croisent. Le mot carrera apparaît dans un contexte d’études.",
          "pedagogicalQuestion": "Quel indice permet déjà d’interpréter le mot carrera avant la clarification ?",
          "overlay": null
        },
        {
          "id": "annotation-07",
          "segmentId": "segment-07",
          "note": "La participante décrit une compréhension partielle mais opératoire : comprendre certaines langues sans les avoir toutes étudiées.",
          "pedagogicalQuestion": "Comment ce segment montre-t-il une compréhension partielle mais utile ?"
        },
        {
          "id": "annotation-08",
          "segmentId": "segment-08",
          "note": "Invitation à signaler une difficulté. Ce type de relance ouvre la négociation du sens.",
          "pedagogicalQuestion": "Où voit-on l’ouverture d’un espace de clarification ?",
          "overlay": null
        },
        {
          "id": "annotation-09",
          "segmentId": "segment-09",
          "note": "Moment central : le groupe répare collectivement un faux ami partiel entre carrera et carrière.",
          "pedagogicalQuestion": "Où voit-on une négociation du sens autour de carrera ?"
        },
        {
          "id": "annotation-10",
          "segmentId": "segment-10",
          "note": "Nouveau segment plurilingue spontané : le participant mobilise plusieurs langues dans une même présentation.",
          "pedagogicalQuestion": "Comment le participant combine-t-il plusieurs langues pour rester compréhensible ?",
          "overlay": null
        },
        {
          "id": "annotation-11",
          "segmentId": "segment-11",
          "note": "Le groupe revient à la compréhension et au répertoire linguistique. On observe la circulation entre présentation, clarification et pluralité des langues.",
          "pedagogicalQuestion": "Qu’est-ce que le groupe comprend collectivement du répertoire de Yassine ?"
        }
